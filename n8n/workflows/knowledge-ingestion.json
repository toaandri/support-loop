{
  "name": "SupportLoop — Knowledge Ingestion Trigger",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-loop/ingest",
        "responseMode": "responseNode",
        "authentication": "headerAuth"
      },
      "id": "ingest-webhook",
      "name": "Ingestion Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPPORT_LOOP_BACKEND_URL || 'http://backend:3000'}}/api/support/ingest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-support-key",
              "value": "={{ $env.SUPPORT_ADMIN_KEY || '' }}"
            }
          ]
        },
        "options": {
          "timeout": 180000
        }
      },
      "id": "run-ingestion",
      "name": "Run Knowledge Ingest Script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "ingest-response",
      "name": "Return Ingestion Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        780,
        300
      ]
    }
  ],
  "connections": {
    "Ingestion Webhook": {
      "main": [
        [
          {
            "node": "Run Knowledge Ingest Script",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Knowledge Ingest Script": {
      "main": [
        [
          {
            "node": "Return Ingestion Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "notes": "Calls the backend ingestion API. Requires RAG mode. The backend controls the document directory; n8n does not execute shell commands or access PostgreSQL."
}
